for ticker in TICKERS:

    print("\nProcessing:", ticker)

    data = download_data(ticker)

    if data.empty:

        print("Skipped: No historical data")
        continue

    print(
        "Rows:",
        len(data),
        "| Start:",
        data.index[0].date(),
        "| End:",
        data.index[-1].date()
    )

    # Split raw data chronologically
    split = int(len(data) * TRAIN_SPLIT)

    if split <= LONG_WINDOW or len(data) - split < 30:

        print("Skipped: Insufficient train/test observations")
        continue

    # Calculate features using historical information.
    # Test indicators retain the training-period warm-up.
    full_work = backtest_ma(
        data,
        SHORT_WINDOW,
        LONG_WINDOW,
        INITIAL_CAPITAL,
        COST_PER_SIDE
    )

    if full_work is None:

        print("Skipped: Full backtest failed")
        continue

    # Split using the original date boundary
    split_date = data.index[split]

    train_work = full_work[
        full_work.index < split_date
    ].copy()

    test_work = full_work[
        full_work.index >= split_date
    ].copy()

    if len(train_work) < 10 or len(test_work) < 10:

        print("Skipped: Insufficient backtest rows")
        continue

    # Rebuild portfolios separately.
    # Test starts with fresh capital and charges an entry
    # cost if a position is active on its first test day.

    def reset_portfolio(work):

        work = work.copy()

        work["Position_Change"] = (
            work["Position"]
            .diff()
            .abs()
            .fillna(work["Position"].abs())
        )

        work["Transaction_Cost"] = (
            work["Position_Change"] * COST_PER_SIDE
        )

        work["Net_Return"] = (
            work["Gross_Return"] -
            work["Transaction_Cost"]
        )

        work["Strategy_Portfolio"] = (
            INITIAL_CAPITAL *
            (1 + work["Net_Return"]).cumprod()
        )

        work["Benchmark_Portfolio"] = (
            INITIAL_CAPITAL *
            (1 + work["Benchmark_Return"]).cumprod()
        )

        work["Portfolio_Peak"] = (
            work["Strategy_Portfolio"]
            .cummax()
            .clip(lower=INITIAL_CAPITAL)
        )

        work["Drawdown"] = (
            work["Strategy_Portfolio"] /
            work["Portfolio_Peak"]
        ) - 1

        return work

    train_work = reset_portfolio(train_work)

    test_work = reset_portfolio(test_work)

    full_m = compute_metrics(full_work)

    train_m = compute_metrics(train_work)

    test_m = compute_metrics(test_work)

    if full_m is None or train_m is None or test_m is None:

        print("Skipped: Metrics unavailable")
        continue

    all_works[ticker] = full_work

    all_test_works[ticker] = test_work

    # Save metrics
    all_results.append({

        "Ticker": ticker,

        "Full_Return_Pct": full_m["Total_Return_Pct"],

        "Full_Sharpe": full_m["Sharpe"],

        "Full_Max_DD_Pct": full_m["Max_Drawdown_Pct"],

        "Full_Benchmark_Return_Pct":
            full_m["Benchmark_Return_Pct"],

        "Train_Return_Pct": train_m["Total_Return_Pct"],

        "Train_Sharpe": train_m["Sharpe"],

        "Train_Benchmark_Return_Pct":
            train_m["Benchmark_Return_Pct"],

        "Test_Return_Pct": test_m["Total_Return_Pct"],

        "Test_Sharpe": test_m["Sharpe"],

        "Test_Max_DD_Pct": test_m["Max_Drawdown_Pct"],

        "Test_Benchmark_Return_Pct":
            test_m["Benchmark_Return_Pct"]

    })

    all_trades.extend(
        extract_trades(
            full_work,
            ticker,
            COST_PER_SIDE
        )
    )

    print(
        "Full Return:",
        full_m["Total_Return_Pct"], "%"
    )

    print(
        "Train Return:",
        train_m["Total_Return_Pct"], "%"
    )

    print(
        "Test Return:",
        test_m["Total_Return_Pct"], "%"
    )

    print(
        "Test Sharpe:",
        test_m["Sharpe"]
    )


