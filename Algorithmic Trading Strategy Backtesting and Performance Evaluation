# ============================================================
# 2. DOWNLOAD HISTORICAL DATA
# ============================================================

def download_data(ticker):

    try:

        raw = yf.download(
            ticker,
            period=PERIOD,
            interval=INTERVAL,
            auto_adjust=True,
            progress=False,
            threads=False
        )

        if raw is None or raw.empty:
            print("No data available:", ticker)
            return pd.DataFrame()

        # Handle MultiIndex columns
        if isinstance(raw.columns, pd.MultiIndex):

            try:
                raw = raw.xs(
                    ticker,
                    axis=1,
                    level=-1
                )

            except (KeyError, ValueError):

                raw.columns = raw.columns.get_level_values(0)

        required = [
            "Open",
            "High",
            "Low",
            "Close",
            "Volume"
        ]

        if not all(col in raw.columns for col in required):

            print("Required columns missing:", ticker)
            return pd.DataFrame()

        data = raw[required].copy()

        data.index = pd.to_datetime(data.index)

        data = data[
            ~data.index.duplicated(keep="first")
        ].sort_index()

        for col in required:

            data[col] = pd.to_numeric(
                data[col],
                errors="coerce"
            )

        data = data.replace(
            [np.inf, -np.inf],
            np.nan
        )

        data = data.dropna(
            subset=["Open", "Close"]
        )

        data = data[
            (data["Open"] > 0) &
            (data["Close"] > 0)
        ]

        return data

    except Exception as e:

        print("Download failed:", ticker, str(e))
        return pd.DataFrame()


# ============================================================
# 3. FEATURE ENGINEERING AND BACKTESTING
# ============================================================

def backtest_ma(
    data,
    short=SHORT_WINDOW,
    long=LONG_WINDOW,
    capital=INITIAL_CAPITAL,
    cost=COST_PER_SIDE
):

    if data is None or len(data) < long + 10:
        return None

    work = data.copy()

    # Moving averages
    work["SMA_Short"] = (
        work["Close"].rolling(short).mean()
    )

    work["SMA_Long"] = (
        work["Close"].rolling(long).mean()
    )

    work["EMA_20"] = (
        work["Close"].ewm(
            span=20,
            adjust=False
        ).mean()
    )

    # Signal known at the end of each trading day
    work["Raw_Signal"] = (
        work["SMA_Short"] >
        work["SMA_Long"]
    ).astype(int)

    # Position executed at the next day's opening price
    work["Position"] = (
        work["Raw_Signal"]
        .shift(1)
        .fillna(0)
        .astype(int)
    )

    # Next-day Open price
    work["Next_Open"] = work["Open"].shift(-1)

    # Open-to-next-open return
    work["Market_Return"] = (
        work["Next_Open"] / work["Open"]
    ) - 1

    # Remove rows without valid forward prices
    work = work.dropna(
        subset=[
            "SMA_Short",
            "SMA_Long",
            "Next_Open",
            "Market_Return"
        ]
    ).copy()

    if len(work) < 10:
        return None

    # Position changes = entry or exit
    work["Position_Change"] = (
        work["Position"]
        .diff()
        .abs()
        .fillna(work["Position"].abs())
    )

    # Gross strategy returns
    work["Gross_Return"] = (
        work["Position"] *
        work["Market_Return"]
    )

    # Transaction cost
    work["Transaction_Cost"] = (
        work["Position_Change"] * cost
    )

    # Net strategy returns
    work["Net_Return"] = (
        work["Gross_Return"] -
        work["Transaction_Cost"]
    )

    # Benchmark returns
    work["Benchmark_Return"] = (
        work["Market_Return"]
    )

    # Portfolio values
    work["Strategy_Portfolio"] = (
        capital *
        (1 + work["Net_Return"]).cumprod()
    )

    work["Benchmark_Portfolio"] = (
        capital *
        (1 + work["Benchmark_Return"]).cumprod()
    )

    # Drawdown including initial capital as starting peak
    work["Portfolio_Peak"] = (
        work["Strategy_Portfolio"]
        .cummax()
        .clip(lower=capital)
    )

    work["Drawdown"] = (
        work["Strategy_Portfolio"] /
        work["Portfolio_Peak"]
    ) - 1

    # Signal labels
    previous_position = (
        work["Position"].shift(1).fillna(0)
    )

    work["Signal"] = np.select(
        [
            (work["Position"] == 1) &
            (previous_position == 0),

            (work["Position"] == 0) &
            (previous_position == 1)
        ],
        ["BUY", "SELL"],
        default="HOLD"
    )

    return work


# ============================================================
# 4. PERFORMANCE METRICS
# ============================================================

def compute_metrics(work, capital=INITIAL_CAPITAL):

    if work is None or len(work) == 0:
        return None

    returns = work["Net_Return"].dropna()

    portfolio = work["Strategy_Portfolio"]

    if len(returns) == 0:
        return None

    final_value = portfolio.iloc[-1]

    total_return = (
        final_value / capital - 1
    ) * 100

    years = len(returns) / 252

    if years > 0 and final_value > 0:

        cagr = (
            (final_value / capital) ** (1 / years) - 1
        ) * 100

    else:
        cagr = np.nan

    volatility = returns.std()

    if volatility > 0:

        sharpe = (
            returns.mean() /
            volatility
        ) * np.sqrt(252)

    else:
        sharpe = np.nan

    max_drawdown = (
        work["Drawdown"].min() * 100
    )

    benchmark_value = (
        work["Benchmark_Portfolio"].iloc[-1]
    )

    benchmark_return = (
        benchmark_value / capital - 1
    ) * 100

    return {

        "Total_Return_Pct": round(total_return, 2),

        "CAGR_Pct": round(cagr, 2)
        if np.isfinite(cagr) else np.nan,

        "Sharpe": round(sharpe, 3)
        if np.isfinite(sharpe) else np.nan,

        "Max_Drawdown_Pct": round(max_drawdown, 2),

        "Volatility_Pct": round(
            volatility * np.sqrt(252) * 100, 2
        ),

        "Benchmark_Return_Pct": round(
            benchmark_return, 2
        ),

        "Final_Portfolio_Value": round(
            final_value, 2
        )
    }


