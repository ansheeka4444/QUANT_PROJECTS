# 5. TRADE EXTRACTION
# ============================================================

TRADE_COLUMNS = [
    "Ticker",
    "Entry_Date",
    "Exit_Date",
    "Entry_Price",
    "Exit_Price",
    "Gross_Return",
    "Net_Return",
    "Win"
]


def extract_trades(work, ticker, cost=COST_PER_SIDE):

    trades = []

    if work is None or work.empty:
        return trades

    in_trade = False

    entry_date = None
    entry_price = None

    for i in range(len(work)):

        position = int(work["Position"].iloc[i])

        current_date = work.index[i]
        current_price = float(work["Open"].iloc[i])

        if position == 1 and not in_trade:

            entry_date = current_date
            entry_price = current_price

            in_trade = True

        elif position == 0 and in_trade:

            exit_date = current_date
            exit_price = current_price

            gross = (
                exit_price / entry_price
            ) - 1

            net = (
                exit_price * (1 - cost)
            ) / (
                entry_price * (1 + cost)
            ) - 1

            trades.append({

                "Ticker": ticker,

                "Entry_Date": entry_date,

                "Exit_Date": exit_date,

                "Entry_Price": entry_price,

                "Exit_Price": exit_price,

                "Gross_Return": gross,

                "Net_Return": net,

                "Win": bool(net > 0)
            })

            in_trade = False

    # Close any remaining position at the last available
    # next-day opening price used in the backtest.

    if in_trade:

        exit_date = work.index[-1] + pd.Timedelta(days=1)

        exit_price = float(work["Next_Open"].iloc[-1])

        gross = (
            exit_price / entry_price
        ) - 1

        net = (
            exit_price * (1 - cost)
        ) / (
            entry_price * (1 + cost)
        ) - 1

        trades.append({

            "Ticker": ticker,

            "Entry_Date": entry_date,

            "Exit_Date": exit_date,

            "Entry_Price": entry_price,

            "Exit_Price": exit_price,

            "Gross_Return": gross,

            "Net_Return": net,

            "Win": bool(net > 0)
        })

    return trades


