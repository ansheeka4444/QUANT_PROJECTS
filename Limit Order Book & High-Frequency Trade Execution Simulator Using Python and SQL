print("\n--- LATENCY IMPACT SIMULATION ---")

def simulate_latency(order_qty, initial_book, latency_ms=250):

    expected_ask = initial_book.get_best_ask()

    if expected_ask is None:
        return None

    # Calculate liquidity at the best ask level
    best_level_qty = sum(
        order.remaining
        for order in initial_book.asks[expected_ask]
    )

    # During simulated latency, another market participant
    # consumes the displayed liquidity at the best ask.
    competitor_order = Order(
        900001,
        "BUY",
        price=None,
        qty=best_level_qty,
        timestamp=20
    )

    competitor_trades = initial_book.execute_market_order(
        competitor_order
    )

    # Our order arrives after the competing execution
    user_order = Order(
        900002,
        "BUY",
        price=None,
        qty=order_qty,
        timestamp=21
    )

    user_trades = initial_book.execute_market_order(
        user_order
    )

    if user_order.filled > 0:

        avg_price = (
            sum(
                t["Price"] * t["Quantity"]
                for t in user_trades
            ) / user_order.filled
        )

        latency_cost = avg_price - expected_ask

        latency_cost_bps = (
            latency_cost / expected_ask
        ) * 10000

    else:

        avg_price = None
        latency_cost = None
        latency_cost_bps = None

    return {

        "Expected_Ask": expected_ask,
        "Actual_Avg_Fill": avg_price,
        "Latency_Cost": latency_cost,
        "Latency_Cost_Bps": latency_cost_bps,
        "Latency_ms": latency_ms,
        "Competitor_Consumed_Qty": competitor_order.filled,
        "Our_Filled_Qty": user_order.filled,
        "Our_Unfilled_Qty": user_order.remaining,
        "Fill_Rate_Pct": (
            user_order.filled / order_qty
        ) * 100

    }


