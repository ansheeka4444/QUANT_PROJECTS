# ============================================================
# 1. ORDER DATA STRUCTURE
# ============================================================

class Order:

    def __init__(self, order_id, side, price, qty, timestamp):

        if side not in ["BUY", "SELL"]:
            raise ValueError("Side must be BUY or SELL")

        if qty <= 0:
            raise ValueError("Quantity must be positive")

        if price is not None and price <= 0:
            raise ValueError("Price must be positive")

        self.order_id = order_id
        self.side = side
        self.price = price
        self.qty = qty
        self.timestamp = timestamp

        self.filled = 0
        self.status = "NEW"

    @property
    def remaining(self):
        return self.qty - self.filled


# ============================================================
# 2. LIMIT ORDER BOOK ENGINE
# ============================================================

class OrderBook:

    def __init__(self):

        self.bids = {}
        self.asks = {}

        self.trade_history = []
        self.event_history = []
        self.orders = {}

    def log_event(self, order, event_type, details=""):

        self.event_history.append({

            "Order_ID": order.order_id,
            "Side": order.side,
            "Event": event_type,
            "Price": order.price,
            "Quantity": order.qty,
            "Filled": order.filled,
            "Remaining": order.remaining,
            "Timestamp": order.timestamp,
            "Status": order.status,
            "Details": details

        })

    def register_order(self, order):

        if order.order_id in self.orders:
            raise ValueError(
                f"Duplicate Order ID: {order.order_id}"
            )

        self.orders[order.order_id] = order

    # --------------------------------------------------------
    # LIMIT ORDER EXECUTION
    # --------------------------------------------------------

    def add_limit_order(self, order):

        self.register_order(order)

        self.log_event(
            order,
            "LIMIT_ORDER_SUBMITTED"
        )

        trades = self.match_order(
            order,
            market_order=False
        )

        if order.remaining > 0:

            book = (
                self.bids
                if order.side == "BUY"
                else self.asks
            )

            if order.price not in book:
                book[order.price] = deque()

            # Remaining quantity joins the FIFO queue
            book[order.price].append(order)

            if order.filled > 0:
                order.status = "PARTIALLY_FILLED"
            else:
                order.status = "ACTIVE"

            self.log_event(
                order,
                "LIMIT_ORDER_RESTING"
            )

        else:

            order.status = "FILLED"

        return trades

    # --------------------------------------------------------
    # MARKET ORDER EXECUTION
    # --------------------------------------------------------

    def execute_market_order(self, order):

        self.register_order(order)

        self.log_event(
            order,
            "MARKET_ORDER_SUBMITTED"
        )

        trades = self.match_order(
            order,
            market_order=True
        )

        # Market orders never rest in the book.
        if order.remaining > 0:

            if order.filled > 0:
                order.status = "PARTIALLY_FILLED_CANCELLED"
            else:
                order.status = "UNFILLED_CANCELLED"

            self.log_event(
                order,
                "MARKET_REMAINDER_CANCELLED"
            )

        else:

            order.status = "FILLED"

        return trades

    # --------------------------------------------------------
    # FIFO PRICE-TIME MATCHING ENGINE
    # --------------------------------------------------------

    def match_order(self, incoming_order, market_order=False):

        trades = []

        opposite_book = (
            self.asks
            if incoming_order.side == "BUY"
            else self.bids
        )

        # Best price first
        prices = sorted(
            opposite_book.keys(),
            reverse=(incoming_order.side == "SELL")
        )

        for price in prices:

            # Stop if a limit order cannot cross this price
            if not market_order:

                if incoming_order.side == "BUY":
                    if incoming_order.price < price:
                        break

                else:
                    if incoming_order.price > price:
                        break

            queue = opposite_book[price]

            # FIFO matching at each price level
            while queue and incoming_order.remaining > 0:

                resting_order = queue[0]

                available_qty = resting_order.remaining
                required_qty = incoming_order.remaining

                trade_qty = min(
                    available_qty,
                    required_qty
                )

                resting_order.filled += trade_qty
                incoming_order.filled += trade_qty

                trade = {

                    "Timestamp": incoming_order.timestamp,
                    "Price": price,
                    "Quantity": trade_qty,

                    "Buyer_ID": (
                        incoming_order.order_id
                        if incoming_order.side == "BUY"
                        else resting_order.order_id
                    ),

                    "Seller_ID": (
                        incoming_order.order_id
                        if incoming_order.side == "SELL"
                        else resting_order.order_id
                    ),

                    "Aggressor_Side": incoming_order.side

                }

                trades.append(trade)
                self.trade_history.append(trade)

                self.log_event(
                    incoming_order,
                    "TRADE_EXECUTED",
                    f"Executed {trade_qty} at {price}"
                )

                self.log_event(
                    resting_order,
                    "RESTING_ORDER_FILLED",
                    f"Executed {trade_qty} at {price}"
                )

                if resting_order.remaining == 0:

                    resting_order.status = "FILLED"
                    queue.popleft()

                else:

                    # Preserve FIFO priority for remaining quantity
                    resting_order.status = "PARTIALLY_FILLED"
                    break

            if not queue:
                del opposite_book[price]

            if incoming_order.remaining == 0:
                incoming_order.status = "FILLED"
                break

        return trades

    # --------------------------------------------------------
    # BEST BID / ASK
    # --------------------------------------------------------

    def get_best_bid(self):

        return (
            max(self.bids.keys())
            if self.bids
            else None
        )

    def get_best_ask(self):

        return (
            min(self.asks.keys())
            if self.asks
            else None
        )

    # --------------------------------------------------------
    # QUEUE POSITION
    # --------------------------------------------------------

    def get_queue_position(self, order_id):

        for book in [self.bids, self.asks]:

            for price, queue in book.items():

                for i, order in enumerate(queue):

                    if order.order_id == order_id:

                        qty_ahead = sum(
                            o.remaining
                            for o in list(queue)[:i]
                        )

                        return qty_ahead

        return None

    # --------------------------------------------------------
    # ORDER CANCELLATION
    # --------------------------------------------------------

    def cancel_order(self, order_id):

        order = self.orders.get(order_id)

        if order is None:
            return False

        if order.status not in [
            "ACTIVE",
            "PARTIALLY_FILLED"
        ]:
            return False

        book = (
            self.bids
            if order.side == "BUY"
            else self.asks
        )

        if order.price in book:

            queue = book[order.price]

            for resting_order in list(queue):

                if resting_order.order_id == order_id:

                    queue.remove(resting_order)

                    if not queue:
                        del book[order.price]

                    order.status = "CANCELLED"

                    self.log_event(
                        order,
                        "ORDER_CANCELLED"
                    )

                    return True

        return False

    # --------------------------------------------------------
    # ORDER BOOK DEPTH
    # --------------------------------------------------------

    def get_depth(self):

        rows = []

        for price, queue in self.bids.items():

            rows.append({

                "Side": "BUY",
                "Price": price,
                "Quantity": sum(
                    o.remaining for o in queue
                )

            })

        for price, queue in self.asks.items():

            rows.append({

                "Side": "SELL",
                "Price": price,
                "Quantity": sum(
                    o.remaining for o in queue
                )

            })

        return pd.DataFrame(rows)


