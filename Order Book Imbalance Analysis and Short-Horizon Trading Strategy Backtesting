    trades["signal"] == 1,
    trades["future_best_bid"],
    trades["future_best_ask"]
)

trades = trades.dropna(
    subset=["entry_price", "exit_price"]
).copy()

trades["gross_pnl"] = np.where(
    trades["signal"] == 1,
    (
        trades["exit_price"] -
        trades["entry_price"]
    ) * POSITION_SIZE,
    (
        trades["entry_price"] -
        trades["exit_price"]
    ) * POSITION_SIZE
)

trades["slippage_cost"] = (
    trades["entry_price"] +
    trades["exit_price"]
) * SLIPPAGE_BPS / 10000 * POSITION_SIZE

trades["fee_cost"] = (
    trades["entry_price"] +
    trades["exit_price"]
) * FEE_BPS / 10000 * POSITION_SIZE

trades["net_pnl"] = (
    trades["gross_pnl"] -
    trades["slippage_cost"] -
    trades["fee_cost"]
)

