def calculate_metrics(data, pnl_column="net_pnl"):

    if data.empty:
        return {
            "Total Trades": 0,
            "Winning Trades": 0,
            "Losing Trades": 0,
            "Zero PnL Trades": 0,
            "Win Rate (%)": np.nan,
            "Gross PnL": 0.0,
            "Net PnL": 0.0,
            "Average PnL": np.nan,
            "Profit Factor": np.nan,
            "Max Drawdown": 0.0
        }

    pnl = pd.to_numeric(
        data[pnl_column],
        errors="coerce"
    ).dropna()

    if len(pnl) == 0:
        return {
            "Total Trades": 0,
            "Winning Trades": 0,
            "Losing Trades": 0,
            "Zero PnL Trades": 0,
            "Win Rate (%)": np.nan,
            "Gross PnL": 0.0,
            "Net PnL": 0.0,
            "Average PnL": np.nan,
            "Profit Factor": np.nan,
            "Max Drawdown": 0.0
        }

    positive_pnl = pnl[pnl > 0].sum()
    negative_pnl = pnl[pnl < 0].sum()

    wins = (pnl > 0).sum()
    losses = (pnl < 0).sum()
    zeros = (pnl == 0).sum()

    total_trades = len(pnl)

    win_rate = (
        wins / total_trades * 100
    )

    if negative_pnl < 0:
        profit_factor = (
            positive_pnl / abs(negative_pnl)
        )
    else:
        profit_factor = np.inf if positive_pnl > 0 else np.nan

    if "future_time" in data.columns:
        ordered = data.loc[pnl.index].sort_values(
            "future_time"
        )
        ordered_pnl = pd.to_numeric(
            ordered[pnl_column],
            errors="coerce"
        ).fillna(0)
    else:
        ordered_pnl = pnl

    cumulative = ordered_pnl.cumsum()
    drawdown = cumulative - cumulative.cummax()

    max_drawdown = (
        drawdown.min() if len(drawdown) else 0
    )

    return {
        "Total Trades": int(total_trades),
        "Winning Trades": int(wins),
        "Losing Trades": int(losses),
        "Zero PnL Trades": int(zeros),
        "Win Rate (%)": round(win_rate, 2),
        "Gross PnL": round(float(data["gross_pnl"].sum()), 5),
        "Net PnL": round(float(pnl.sum()), 5),
        "Average PnL": round(float(pnl.mean()), 6),
        "Profit Factor": round(float(profit_factor), 4)
            if np.isfinite(profit_factor) else profit_factor,
        "Max Drawdown": round(float(max_drawdown), 5)
    }


overlap_metrics = calculate_metrics(trades)

