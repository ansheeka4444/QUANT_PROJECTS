def convert_to_list(value):

    if value is None:
        return []

    if isinstance(value, np.ndarray):
        return value.tolist()

    if isinstance(value, (list, tuple)):
        return list(value)

    if hasattr(value, "as_py"):
        converted = value.as_py()
        return converted if isinstance(converted, list) else []

    if hasattr(value, "to_pylist"):
        return value.to_pylist()

    return []


def safe_first(value):

    values = convert_to_list(value)

    if not values:
        return np.nan

    try:
        return float(values[0])
    except (TypeError, ValueError):
        return np.nan


def safe_sum(value, levels=5):

    values = convert_to_list(value)

    try:
        return sum(
            float(x)
            for x in values[:levels]
            if x is not None
        )
    except (TypeError, ValueError):
        return np.nan


df["best_bid"] = pd.to_numeric(
