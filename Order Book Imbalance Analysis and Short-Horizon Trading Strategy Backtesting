        "total_ask_depth"
    ]
).copy()

df = df[
    (df["best_bid"] > 0) &
    (df["best_ask"] > 0) &
    (df["best_ask"] >= df["best_bid"]) &
    (df["bid_size_1"] >= 0) &
    (df["ask_size_1"] >= 0) &
    (df["total_bid_depth"] >= 0) &
    (df["total_ask_depth"] >= 0)
].copy()

df = df.drop_duplicates(
