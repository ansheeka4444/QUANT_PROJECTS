# ============================================================
# 5. FEATURE ENGINEERING
# ============================================================

df["mid_price"] = (
    df["best_bid"] + df["best_ask"]
) / 2

df["spread"] = (
    df["best_ask"] - df["best_bid"]
)

df["relative_spread"] = (
    df["spread"] / df["mid_price"]
)

depth_total = (
    df["total_bid_depth"] +
    df["total_ask_depth"]
)

df["obi"] = np.where(
    depth_total > 0,
    (
        df["total_bid_depth"] -
        df["total_ask_depth"]
    ) / depth_total,
    np.nan
)

microprice_denominator = (
    df["bid_size_1"] +
    df["ask_size_1"]
)

df["microprice"] = np.where(
    microprice_denominator > 0,
    (
        df["best_ask"] * df["bid_size_1"] +
        df["best_bid"] * df["ask_size_1"]
    ) / microprice_denominator,
    df["mid_price"]
)

feature_columns = [
    "mid_price",
    "spread",
    "relative_spread",
    "obi",
    "microprice"
]

df[feature_columns] = (
    df[feature_columns]
    .replace([np.inf, -np.inf], np.nan)
)

df = df.dropna(
    subset=feature_columns
).copy()

