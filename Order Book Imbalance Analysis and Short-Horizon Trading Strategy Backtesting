# 14. THRESHOLD SENSITIVITY
# ============================================================

threshold_results = []

for threshold in [0.05, 0.10, 0.15, 0.20, 0.25, 0.30]:

    temp = df.copy()

    temp["temp_signal"] = np.select(
        [
            temp["obi"] > threshold,
            temp["obi"] < -threshold
        ],
        [1, -1],
        default=0
    )

    temp = temp[
        temp["temp_signal"] != 0
    ].copy()

    temp["temp_entry"] = np.where(
        temp["temp_signal"] == 1,
        temp["best_ask"],
        temp["best_bid"]
    )

    temp["temp_exit"] = np.where(
        temp["temp_signal"] == 1,
        temp["future_best_bid"],
        temp["future_best_ask"]
    )

    temp = temp.dropna(
        subset=["temp_entry", "temp_exit"]
    )

    temp["temp_gross_pnl"] = np.where(
        temp["temp_signal"] == 1,
        (
            temp["temp_exit"] - temp["temp_entry"]
        ) * POSITION_SIZE,
        (
            temp["temp_entry"] - temp["temp_exit"]
        ) * POSITION_SIZE
    )

    temp["temp_net_pnl"] = (
        temp["temp_gross_pnl"] -
        (
            temp["temp_entry"] + temp["temp_exit"]
        ) * FEE_BPS / 10000 * POSITION_SIZE -
        (
            temp["temp_entry"] + temp["temp_exit"]
        ) * SLIPPAGE_BPS / 10000 * POSITION_SIZE
    )

    threshold_results.append({
        "OBI_Threshold": threshold,
        "Total_Trades": len(temp),
        "Net_PnL": temp["temp_net_pnl"].sum(),
        "Average_PnL": temp["temp_net_pnl"].mean(),
        "Win_Rate": (
            (temp["temp_net_pnl"] > 0).mean() * 100
            if len(temp) else np.nan
        )
    })

threshold_analysis = pd.DataFrame(
