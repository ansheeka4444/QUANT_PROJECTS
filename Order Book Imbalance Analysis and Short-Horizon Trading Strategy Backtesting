def run_non_overlapping_backtest(
    trade_data,
    slippage_bps=0,
    fee_bps=0
):

    if trade_data.empty:
        return pd.DataFrame()

    ordered = trade_data.sort_values(
        ["market_slug", "captured_at"]
    ).copy()

    accepted = []

    for market, group in ordered.groupby("market_slug"):

        last_exit_time = pd.Timestamp.min.tz_localize("UTC")

        for _, row in group.iterrows():

            entry_time = row["captured_at"]
            exit_time = row["future_time"]

            if pd.isna(exit_time):
                continue

            if entry_time < last_exit_time:
                continue

            entry_price = row["entry_price"]
            exit_price = row["exit_price"]

            gross = row["gross_pnl"]

            slippage_cost = (
                entry_price + exit_price
            ) * slippage_bps / 10000 * POSITION_SIZE

            fee_cost = (
                entry_price + exit_price
            ) * fee_bps / 10000 * POSITION_SIZE

            net = (
                gross -
                slippage_cost -
                fee_cost
            )

            record = row.to_dict()

            record["scenario_slippage_cost"] = slippage_cost
            record["scenario_fee_cost"] = fee_cost
            record["scenario_net_pnl"] = net

            accepted.append(record)

            last_exit_time = exit_time

    return pd.DataFrame(accepted)


non_overlap = run_non_overlapping_backtest(
    trades,
    slippage_bps=SLIPPAGE_BPS,
    fee_bps=FEE_BPS
)

