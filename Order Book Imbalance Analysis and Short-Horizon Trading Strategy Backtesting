df["ask_size_1"] = df["ask_sizes"].apply(safe_first)

df["total_bid_depth"] = df["bid_sizes"].apply(
    lambda x: safe_sum(x, 5)
)

df["total_ask_depth"] = df["ask_sizes"].apply(
    lambda x: safe_sum(x, 5)
)

