# ============================================================
# 6. 30-SECOND FUTURE PRICE MATCHING
# ============================================================

future_data = df[
    [
        "token_id",
        "captured_at",
        "mid_price",
        "best_bid",
        "best_ask"
    ]
].copy()

future_data = future_data.rename(
    columns={
        "captured_at": "future_time",
        "mid_price": "future_mid_price",
        "best_bid": "future_best_bid",
        "best_ask": "future_best_ask"
    }
)

df["target_time"] = (
    df["captured_at"] +
    pd.Timedelta(seconds=FORWARD_SECONDS)
)

left_data = df.sort_values(
    ["target_time", "token_id"]
).copy()

right_data = future_data.sort_values(
    ["future_time", "token_id"]
).copy()

df = pd.merge_asof(
    left_data,
    right_data,
    left_on="target_time",
    right_on="future_time",
    by="token_id",
    direction="forward",
    tolerance=pd.Timedelta(
        seconds=MATCH_TOLERANCE_SECONDS
    )
)

df["actual_horizon_seconds"] = (
    df["future_time"] - df["captured_at"]
).dt.total_seconds()

df = df[
    df["actual_horizon_seconds"].between(
        FORWARD_SECONDS,
        FORWARD_SECONDS + MATCH_TOLERANCE_SECONDS
    )
].copy()

df["forward_return"] = (
    df["future_mid_price"] - df["mid_price"]
) / df["mid_price"]

df["forward_return_bps"] = (
    df["forward_return"] * 10000
)

print("\nFuture price matching completed!")
print("Valid observations:", len(df))

